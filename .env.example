# Copy to .env.local and fill in. Never commit real values.
# Required for the demo: MONGODB_URI, SESSION_SECRET, GEMINI_API_KEY, Stripe test keys, Cloudinary.
# Everything else degrades gracefully when empty.
MONGODB_URI=
MONGODB_DB=treedorm
SESSION_SECRET=
GEMINI_API_KEY=
# gemini-2.5-flash is no longer available to new API keys; 3.8 flash with low thinking answers in ~5s.
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the main model is overloaded.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# For Ask Tree Dorm search (text-embedding-004 isn't offered to new keys).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
PERCEPTRON_API_KEY=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BACKBOARD_API_KEY=
RESEND_API_KEY=
# Sender for sign-in emails. onboarding@resend.dev only works for testing; use a verified domain to reach any .edu inbox.
RESEND_FROM=
APP_URL=http://localhost:3000
